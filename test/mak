#1/bin/sh

#TG = TARGET
#SRC = SOURCE
#LC = LOCAL

# Source directory
SRC_DIR=../src

# Target
TG_NAME="libnekocl.so"
TG_DIR=$PREFIX/lib
TG_INC=$PREFIX/include
TG_CC=gcc
TG_WFLAGS="-Werror -Wall -Wextra"
TG_CFLAGS="$TG_WFLAGS -std=c99 -O3"
TG_LIB="-shared -fPIC"

# Local
LC_OPT=$1
LC_FILE=$2
LC_VER="0.0.1"

# echo(color,str)
echo_cl() {
	COLOR=$1
	STR=$2

	GREEN="\033[32m"
	RED="\033[31m"
	YELLOW="\033[33m"
	RESET="\033[0m"

	case $COLOR in
		red)
			printf "${RED}${STR}${RESET}"
			;;
		yellow)
			printf "${YELLOW}${STR}${RESET}"
			;;
		green)
			printf "${GREEN}${STR}${RESET}"
			;;
		*)
			printf "${RED} color ${COLOR} not found ${RESET}"
			;;
	esac

}

install() {
	cp ./$TG_NAME $TG_DIR
	cp $SRC_DIR/nekocl.h $TG_INC
}

uninstall() {
	rm $TG_DIR/$TG_NAME
	rm $TG_INC/nekocl.h
}

perf_exec() {
	OPT=$1

	if command -v perf == 0 ; then
		if [ -f "$LC_FILE" ]; then
			LD_LIBRARY_PATH=.:$LD_LIBRARY_PATH perf stat -e $OPT $LC_FILE
			return 0
		elif [ ! -f "$LC_FILE" ]; then
			echo_cl red "\n\n file $LC_FILE not found\n\n"
			return 1
		else
			echo_cl red "\n\n No input file \n\n"
			return 1
		fi
	else
		echo_cl red "\n\n perf not found\n\n"
	fi
}

run_bin() {
	if [ -f "$LC_FILE" ]; then
		LD_LIBRARY_PATH=.:$LD_LIBRARY_PATH ./$LC_FILE
	elif [ ! -f "$LC_FILE" ]; then
		echo_cl red "\n\n file $LC_FILE not found\n\n"
	else
		echo_cl red "\n\n No input file\n\n"
	fi
}

if [ -z $LC_OPT ]; then
cat <<EOF

	NekoCL Script Manager
	Version $LC_VER

	Usage : $0 option file

	Option :

	[ General ]
	lib - build ouput library
	install - install with \$PREFIX
	uninstall - uninstall with \$PREFIX
	run - run binary ( For *nix kernel )

	Note : This option can perf binary !!!

	[ Hardware ]
	cycle <file> - benchmark cycles
	instr <file> - benchmak instructions
	cmiss <file> - benchmark cache-miss
	branch <file> - benchmark branch
	bmiss <file> - benchmark branch-misses

	[ Kernel ]
	pagef - page fault
	cs - context switch
	tc - task clock

	Example :

	$0 cycle a.out
	$0 lib

	Copyright by viet206 in 2026

EOF
exit 1
fi

case $LC_OPT in
	lib)
		$TG_CC $SRC_DIR/*.c -I../src/ $TG_OPT $TG_LIB -o $TG_NAME
		;;
	install)
		install
		;;
	uninstall)
		uninstall
		;;
		cycle)
		perf_exec cpu-clock
		;;
		instr)
		perf_exec instructions
		;;
		cmiss)
		perf_exec cache-misses
		;;
		branch)
		perf_exec branch-instructions
		;;
		bmiss)
		perf_exec branch-misses
		;;
		pagef)
		perf_exec page-faults
		;;
		cs)
		perf_exec context_switch
		;;
		tc)
		perf_exec task-clock
		;;
		run)
		run_bin $LC_FILE
		;;
	*)
		echo_cl red "\n\n option: $LC_OPT ? \n\n"
		;;
esac
