#TG = TARGET
#SRC = SOURCE
#LC = LOCAL

SRC_DIR=../src

TG_NAME="libnekocl.so"
TG_DIR=$PREFIX/lib
TG_INC=$PREFIX/include

LC_OPT=$1
LC_FILE=$2

CC=gcc

BUILD_LIB="-shared -fPIC"

install() {
	cp ./$TG_NAME $TG_DIR
	cp $SRC_DIR/nekocl.h $TG_INC
}

uninstall() {
	rm $TG_DIR/$TG_NAME
	rm $TG_INC/nekocl.h
}

if [ -z $LC_OPT ]; then
cat <<EOF

	Build Script
	Usage : $0 option file

	Option :

	lib - build ouput library
	install : install with \$PREFIX
	uninstall : uninstall with \$PREFIX

	Example :

	$0 lib

EOF
return 1
fi

case $LC_OPT in
	lib)
		$CC $SRC_DIR/*.c -I../src/ $BUILD_LIB -o $TG_NAME
		;;
	install)
		install
		;;
	uninstall)
		uninstall
		;;
	*)
		printf "\n Option : $LC_OPT ? \n\n"
		;;
esac
